<% contentFor('head') %>
<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<% %>

<% if (!selected_member) { %>
<div class="glass-card-static text-center p-5 my-5">
    <i class="fas fa-users-cog fa-4x text-grad-primary mb-3"></i>
    <h3 class="fw-bold mb-2">Setup Your Profiles First</h3>
    <p class="text-secondary max-width-500 mx-auto mb-4">No family profiles exist yet. Please create a member profile to start viewing the calorie tracker, macro progress, and weight charts.</p>
    <a href="/profiles" class="btn btn-grad px-4 py-2">
        <i class="fas fa-plus me-2"></i>Create Profile
    </a>
</div>
<% } else { %>
<div class="row g-4">
    <!-- Sidebar: Family Members Switcher -->
    <div class="col-lg-3 col-md-4">
        <h5 class="fw-bold mb-3"><i class="fas fa-users me-2 text-grad-primary"></i>Switch Profile</h5>
        <div class="d-flex flex-column gap-2 mb-4">
            <!-- Hidden Select for AJAX Controller reference -->
            <select class="d-none" id="dashboardMemberSelect">
                <% members.forEach(function(m) { %>
                <option value="<%= m.id %>" <%= m.id === selected_member.id ? 'selected' : '' %>><%= m.name %></option>
                <% }); %>
            </select>

            <% members.forEach(function(m) { %>
            <div class="glass-card-static member-switch-card p-3 rounded-4 d-flex align-items-center gap-3 <%= m.id === selected_member.id ? 'active' : '' %>"
                 onclick="switchDashboardMember(<%= m.id %>)">
                <div class="avatar-circle">
                    <%= m.name[0].toUpperCase() %>
                </div>
                <div class="overflow-hidden">
                    <h6 class="mb-0 fw-bold text-truncate"><%= m.name %></h6>
                    <span class="small text-secondary"><%= m.health_goals %></span>
                </div>
            </div>
            <% }); %>
        </div>

        <a href="/profiles" class="btn btn-outline-glass btn-sm w-100 py-2">
            <i class="fas fa-cog me-1"></i>Manage Profiles
        </a>
    </div>

    <!-- Main Dashboard Body -->
    <div class="col-lg-9 col-md-8">
        <!-- Dashboard Header -->
        <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-3">
            <div>
                <h1 class="font-heading fw-bold mb-0">Dashboard: <span class="text-grad-primary"><%= selected_member.name %></span></h1>
                <p class="text-secondary mb-0">Health summaries and targets tailored for <%= selected_member.name %>.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/chat?member_id=<%= selected_member.id %>" class="btn btn-outline-glass py-2">
                    <i class="fas fa-comment-dots me-2"></i>Chat AI
                </a>
                <a href="/meal-planner?member_id=<%= selected_member.id %>" class="btn btn-grad py-2">
                    <i class="fas fa-utensils me-2"></i>Meal Planner
                </a>
            </div>
        </div>

        <!-- Stats Panel -->
        <div class="row g-3 mb-4">
            <!-- Calorie Card -->
            <div class="col-md-4">
                <div class="glass-card p-3 h-100">
                    <span class="small text-secondary text-uppercase fw-bold letter-spacing">Daily Target</span>
                    <h2 class="fw-bold mt-2 mb-1 text-grad-primary"><%= selected_member.target_calories %> <span class="fs-6 text-secondary">kcal</span></h2>
                    <div class="d-flex align-items-center gap-1 mt-3 text-secondary small">
                        <i class="fas fa-calculator"></i>
                        <span>Estimated TDEE: <strong><%= selected_member.tdee %> kcal</strong></span>
                    </div>
                </div>
            </div>

            <!-- BMI Card -->
            <div class="col-md-4">
                <div class="glass-card p-3 h-100">
                    <span class="small text-secondary text-uppercase fw-bold letter-spacing">Current BMI</span>
                    <h2 class="fw-bold mt-2 mb-1 text-<%= selected_member.bmi_category.color %>"><%= selected_member.bmi %></h2>
                    <span class="badge bg-<%= selected_member.bmi_category.color %> badge-pill-grad my-1"><%= selected_member.bmi_category.label %></span>
                </div>
            </div>

            <!-- Diet Preference Card -->
            <div class="col-md-4">
                <div class="glass-card p-3 h-100">
                    <span class="small text-secondary text-uppercase fw-bold letter-spacing">Diet & Region</span>
                    <h3 class="fw-bold mt-2 mb-1 text-truncate"><%= selected_member.dietary_type %></h3>
                    <div class="d-flex align-items-center gap-2 mt-3 text-secondary small">
                        <i class="fas fa-map-marker-alt text-danger"></i>
                        <span>Staple: <strong><%= selected_member.regional_preference %></strong></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Macros Breakdown & Weight Tracker -->
        <div class="row g-4 mb-4">
            <!-- Macro Goals -->
            <div class="col-lg-5">
                <div class="glass-card p-4 h-100">
                    <h5 class="fw-bold mb-3"><i class="fas fa-drumstick-bite me-2 text-grad-primary"></i>Daily Macro Targets</h5>
                    <p class="text-secondary small mb-4">Target nutrient budgets computed for health goal: <strong><%= selected_member.health_goals %></strong>.</p>
                    
                    <% const macros = selected_member.target_macros; %>
                    
                    <!-- Protein -->
                    <div class="macro-box">
                        <div class="macro-label">
                            <span class="dot-indicator" style="background-color: #10b981; width: 10px; height: 10px; border-radius: 50%; display: inline-block;"></span>
                            <span>Protein</span>
                        </div>
                        <strong class="text-success"><%= macros.protein %>g</strong>
                    </div>
                    <div class="macro-bar-container mb-3">
                        <div class="macro-bar-fill bg-success" style="width: 100%"></div>
                    </div>

                    <!-- Carbs -->
                    <div class="macro-box">
                        <div class="macro-label">
                            <span class="dot-indicator" style="background-color: #06b6d4; width: 10px; height: 10px; border-radius: 50%; display: inline-block;"></span>
                            <span>Carbohydrates</span>
                        </div>
                        <strong class="text-info"><%= macros.carbs %>g</strong>
                    </div>
                    <div class="macro-bar-container mb-3">
                        <div class="macro-bar-fill bg-info" style="width: 100%"></div>
                    </div>

                    <!-- Fat -->
                    <div class="macro-box">
                        <div class="macro-label">
                            <span class="dot-indicator" style="background-color: #f59e0b; width: 10px; height: 10px; border-radius: 50%; display: inline-block;"></span>
                            <span>Healthy Fats</span>
                        </div>
                        <strong class="text-warning"><%= macros.fat %>g</strong>
                    </div>
                    <div class="macro-bar-container">
                        <div class="macro-bar-fill bg-warning" style="width: 100%"></div>
                    </div>
                </div>
            </div>

            <!-- Weight Log and Chart -->
            <div class="col-lg-7">
                <div class="glass-card p-4 h-100">
                    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
                        <h5 class="fw-bold mb-0"><i class="fas fa-chart-line me-2 text-grad-primary"></i>Weight Tracker Timeline</h5>
                        <!-- Direct Weight Logger form inside dashboard -->
                        <form id="weightLogForm" class="d-flex gap-2 align-items-center">
                            <div class="input-group input-group-sm max-width-150">
                                <input type="number" step="0.1" class="form-control" id="logWeightInput" required placeholder="Weight" min="10" max="300" value="<%= selected_member.weight_kg %>">
                                <span class="input-group-text bg-secondary-subtle border-0 text-secondary">kg</span>
                            </div>
                            <button type="submit" class="btn btn-grad btn-sm py-2 px-3">Log</button>
                        </form>
                    </div>
                    
                    <div class="chart-container mt-4" style="position: relative; height: 260px; width: 100%;">
                        <canvas id="weightHistoryChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<% } %>

<% contentFor('scripts') %>
<!-- Dashboard Core Logic -->
<script src="/static/js/dashboard.js"></script>
<script>
    function switchDashboardMember(id) {
        const select = document.getElementById('dashboardMemberSelect');
        if (select) {
            select.value = id;
            select.dispatchEvent(new Event('change'));
        }
    }
</script>
<% %>
