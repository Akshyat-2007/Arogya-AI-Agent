<% contentFor('head') %>
<style>
    /* Printing styles for clean exports */
    @media print {
        body {
            background: #ffffff !important;
            color: #000000 !important;
        }
        .navbar-glass, footer, .btn-theme-toggle, #generatePlanSection, .btn, .nav-tabs {
            display: none !important;
        }
        .glass-card, .glass-card-static {
            background: #ffffff !important;
            border: 1px solid #dee2e6 !important;
            box-shadow: none !important;
            color: #000000 !important;
            transform: none !important;
        }
        .text-grad-primary, .text-grad-success {
            background: none !important;
            -webkit-text-fill-color: initial !important;
            color: #7c3aed !important;
            font-weight: bold;
        }
    }
</style>
<% %>

<% if (!selected_member) { %>
<div class="glass-card-static text-center p-5 my-5">
    <i class="fas fa-utensils fa-4x text-grad-primary mb-3"></i>
    <h3 class="fw-bold mb-2">Setup Your Profiles First</h3>
    <p class="text-secondary max-width-500 mx-auto mb-4">No family profiles exist yet. Please create a member profile to start generating customized daily and weekly meal plans.</p>
    <a href="/profiles" class="btn btn-grad px-4 py-2">
        <i class="fas fa-plus me-2"></i>Create Profile
    </a>
</div>
<% } else { %>
<div class="row g-4">
    <!-- Header control bar -->
    <div class="col-12" id="generatePlanSection">
        <div class="glass-card-static p-4 rounded-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold text-secondary">Family Member:</span>
                    <select class="form-select border-secondary-subtle" id="mealMemberSelect" style="width: auto; min-width: 150px;">
                        <% members.forEach(function(m) { %>
                        <option value="<%= m.id %>" <%= m.id === selected_member.id ? 'selected' : '' %>><%= m.name %></option>
                        <% }); %>
                    </select>
                </div>
                
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold text-secondary">Plan Type:</span>
                    <select class="form-select border-secondary-subtle" id="planTypeSelect" style="width: auto;">
                        <option value="Daily">Daily Meal Plan</option>
                        <option value="Weekly">Weekly Diet Planner</option>
                    </select>
                </div>
            </div>
            
            <div class="d-flex gap-2">
                <% if (latest_plan) { %>
                <button class="btn btn-outline-glass px-4" id="printPlanBtn">
                    <i class="fas fa-print me-2"></i>Print/Save
                </button>
                <% } %>
                <button class="btn btn-grad px-4" id="generatePlanBtn">
                    <i class="fas fa-magic me-2"></i>Generate Plan
                </button>
            </div>
        </div>
    </div>

    <!-- Main plan display container -->
    <div class="col-12" id="planContainer">
        <% if (!latest_plan) { %>
        <div class="glass-card text-center p-5">
            <i class="fas fa-magic fa-4x text-grad-primary mb-3"></i>
            <h3 class="fw-bold mb-2">No Active Meal Plan</h3>
            <p class="text-secondary max-width-600 mx-auto mb-4">Craft a customized meal plan for <%= selected_member.name %> based on their calorie targets (<strong><%= selected_member.target_calories %> kcal</strong>) and preferred <strong><%= selected_member.dietary_type %></strong> diet.</p>
            <button class="btn btn-grad px-4 py-2" onclick="document.getElementById('generatePlanBtn').click()">
                <i class="fas fa-magic me-2"></i>Create New Plan
            </button>
        </div>
        <% } else { %>
            <% const plan = latest_plan.parsed_plan; %>
            
            <!-- Daily Plan Layout -->
            <% if (latest_plan.plan_type === 'Daily') { %>
            <div class="row g-4">
                <!-- Left panel: Calorie / Macro summary -->
                <div class="col-lg-4">
                    <div class="glass-card-static p-4 h-100">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle mb-2">Daily Plan Summary</span>
                        <h3 class="fw-bold mb-3 font-heading"><%= selected_member.name %>'s Plan</h3>
                        <hr class="opacity-10">

                        <div class="mb-4">
                            <span class="text-secondary small text-uppercase fw-bold d-block mb-1">Target Caloric Goal</span>
                            <h2 class="fw-bold text-grad-primary mb-0"><%= plan.calories || selected_member.target_calories %> <span class="fs-5 text-secondary">kcal</span></h2>
                        </div>

                        <!-- Macro percentages and levels -->
                        <h6 class="fw-bold mb-3"><i class="fas fa-chart-pie me-2 text-grad-primary"></i>Macros Breakdown</h6>
                        <% const macros = plan.macros || selected_member.target_macros; %>
                        
                        <div class="d-flex justify-content-between mb-2">
                            <span class="small text-secondary"><i class="fas fa-dot-circle text-success me-1"></i>Protein:</span>
                            <strong class="text-success"><%= macros.protein || 0 %>g</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="small text-secondary"><i class="fas fa-dot-circle text-info me-1"></i>Carbohydrates:</span>
                            <strong class="text-info"><%= macros.carbs || 0 %>g</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="small text-secondary"><i class="fas fa-dot-circle text-warning me-1"></i>Fats:</span>
                            <strong class="text-warning"><%= macros.fat || 0 %>g</strong>
                        </div>

                        <% if (plan.recommendations && plan.recommendations.length > 0) { %>
                        <hr class="opacity-10 my-3">
                        <h6 class="fw-bold mb-2"><i class="fas fa-lightbulb me-2 text-warning"></i>Coach Guidelines:</h6>
                        <ul class="small text-secondary ps-3">
                            <% plan.recommendations.forEach(function(rec) { %>
                            <li class="mb-2"><%= rec %></li>
                            <% }); %>
                        </ul>
                        <% } %>
                    </div>
                </div>

                <!-- Right panel: Meals list -->
                <div class="col-lg-8">
                    <div class="d-flex flex-column gap-3">
                        <% const meals = plan.meals || {}; %>
                        
                        <!-- Breakfast -->
                        <% if (meals.breakfast) { %>
                        <% const m = meals.breakfast; %>
                        <div class="glass-card-static p-4 rounded-4 border-start border-4 border-info">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="meal-type-badge meal-breakfast">Breakfast</span>
                                    <h4 class="fw-bold mb-1"><%= m.title %></h4>
                                </div>
                                <span class="badge bg-secondary-subtle text-secondary py-1 px-2"><%= m.calories %> kcal</span>
                            </div>
                            <p class="mb-2 text-secondary small"><strong>Preparation & Portion Size:</strong> <%= m.ingredients %></p>
                            <div class="d-flex gap-3 text-secondary small opacity-75">
                                <span>P: <strong><%= m.protein !== undefined ? m.protein : 'N/A' %>g</strong></span>
                                <span>C: <strong><%= m.carbs !== undefined ? m.carbs : 'N/A' %>g</strong></span>
                                <span>F: <strong><%= m.fat !== undefined ? m.fat : 'N/A' %>g</strong></span>
                            </div>
                        </div>
                        <% } %>

                        <!-- Lunch -->
                        <% if (meals.lunch) { %>
                        <% const m = meals.lunch; %>
                        <div class="glass-card-static p-4 rounded-4 border-start border-4 border-success">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="meal-type-badge meal-lunch">Lunch</span>
                                    <h4 class="fw-bold mb-1"><%= m.title %></h4>
                                </div>
                                <span class="badge bg-secondary-subtle text-secondary py-1 px-2"><%= m.calories %> kcal</span>
                            </div>
                            <p class="mb-2 text-secondary small"><strong>Preparation & Portion Size:</strong> <%= m.ingredients %></p>
                            <div class="d-flex gap-3 text-secondary small opacity-75">
                                <span>P: <strong><%= m.protein !== undefined ? m.protein : 'N/A' %>g</strong></span>
                                <span>C: <strong><%= m.carbs !== undefined ? m.carbs : 'N/A' %>g</strong></span>
                                <span>F: <strong><%= m.fat !== undefined ? m.fat : 'N/A' %>g</strong></span>
                            </div>
                        </div>
                        <% } %>

                        <!-- Snacks -->
                        <% if (meals.snacks) { %>
                        <% const m = meals.snacks; %>
                        <div class="glass-card-static p-4 rounded-4 border-start border-4 border-warning">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="meal-type-badge meal-snacks">Snacks</span>
                                    <h4 class="fw-bold mb-1"><%= m.title %></h4>
                                </div>
                                <span class="badge bg-secondary-subtle text-secondary py-1 px-2"><%= m.calories %> kcal</span>
                            </div>
                            <p class="mb-2 text-secondary small"><strong>Preparation & Portion Size:</strong> <%= m.ingredients %></p>
                            <div class="d-flex gap-3 text-secondary small opacity-75">
                                <span>P: <strong><%= m.protein !== undefined ? m.protein : 'N/A' %>g</strong></span>
                                <span>C: <strong><%= m.carbs !== undefined ? m.carbs : 'N/A' %>g</strong></span>
                                <span>F: <strong><%= m.fat !== undefined ? m.fat : 'N/A' %>g</strong></span>
                            </div>
                        </div>
                        <% } %>

                        <!-- Dinner -->
                        <% if (meals.dinner) { %>
                        <% const m = meals.dinner; %>
                        <div class="glass-card-static p-4 rounded-4 border-start border-4 border-primary">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="meal-type-badge meal-dinner">Dinner</span>
                                    <h4 class="fw-bold mb-1"><%= m.title %></h4>
                                </div>
                                <span class="badge bg-secondary-subtle text-secondary py-1 px-2"><%= m.calories %> kcal</span>
                            </div>
                            <p class="mb-2 text-secondary small"><strong>Preparation & Portion Size:</strong> <%= m.ingredients %></p>
                            <div class="d-flex gap-3 text-secondary small opacity-75">
                                <span>P: <strong><%= m.protein !== undefined ? m.protein : 'N/A' %>g</strong></span>
                                <span>C: <strong><%= m.carbs !== undefined ? m.carbs : 'N/A' %>g</strong></span>
                                <span>F: <strong><%= m.fat !== undefined ? m.fat : 'N/A' %>g</strong></span>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>
            
            <!-- Weekly Plan Layout -->
            <% } else { %>
            <div class="glass-card-static p-4 rounded-4">
                <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
                    <div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle mb-2">Weekly Diet Schedule</span>
                        <h3 class="fw-bold mb-1 font-heading"><%= selected_member.name %>'s Weekly Plan</h3>
                    </div>
                </div>

                <!-- Days Navigation Tabs -->
                <ul class="nav nav-tabs border-secondary-subtle mb-4" id="weeklyPlanTab" role="tablist">
                    <% const weekdays = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]; %>
                    <% weekdays.forEach(function(day, idx) { %>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link <%= idx === 0 ? 'active' : '' %> border-0 px-3 py-2 fw-semibold" 
                                id="<%= day %>-tab" data-bs-toggle="tab" data-bs-target="#<%= day %>" 
                                type="button" role="tab" aria-controls="<%= day %>" aria-selected="<%= idx === 0 ? 'true' : 'false' %>">
                            <%= day %>
                        </button>
                    </li>
                    <% }); %>
                </ul>

                <div class="tab-content" id="weeklyPlanTabContent">
                    <% Object.entries(plan.days || {}).forEach(function([day, day_data], idx) { %>
                    <div class="tab-pane fade <%= idx === 0 ? 'show active' : '' %>" id="<%= day %>" role="tabpanel" aria-labelledby="<%= day %>-tab">
                        <!-- Daily Targets inside tab -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6 col-lg-3">
                                <div class="p-3 bg-secondary-subtle rounded-3 text-center border border-secondary-subtle">
                                    <span class="small text-secondary d-block">Calories</span>
                                    <h4 class="fw-bold text-grad-primary mb-0 mt-1"><%= day_data.calories || 0 %> kcal</h4>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-3">
                                <div class="p-3 bg-secondary-subtle rounded-3 text-center border border-secondary-subtle">
                                    <span class="small text-secondary d-block">Protein</span>
                                    <h4 class="fw-bold text-success mb-0 mt-1"><%= (day_data.macros && day_data.macros.protein) || 0 %>g</h4>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-3">
                                <div class="p-3 bg-secondary-subtle rounded-3 text-center border border-secondary-subtle">
                                    <span class="small text-secondary d-block">Carbohydrates</span>
                                    <h4 class="fw-bold text-info mb-0 mt-1"><%= (day_data.macros && day_data.macros.carbs) || 0 %>g</h4>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-3">
                                <div class="p-3 bg-secondary-subtle rounded-3 text-center border border-secondary-subtle">
                                    <span class="small text-secondary d-block">Fats</span>
                                    <h4 class="fw-bold text-warning mb-0 mt-1"><%= (day_data.macros && day_data.macros.fat) || 0 %>g</h4>
                                </div>
                            </div>
                        </div>

                        <!-- Meals List -->
                        <div class="row g-3">
                            <% Object.entries(day_data.meals || {}).forEach(function([meal_type, m]) { %>
                            <div class="col-md-6">
                                <div class="p-3 bg-secondary-subtle border border-secondary-subtle rounded-4 h-100">
                                    <span class="meal-type-badge meal-<%= meal_type %>"><%= meal_type.charAt(0).toUpperCase() + meal_type.slice(1) %></span>
                                    <h5 class="fw-bold mb-1"><%= m.title %></h5>
                                    <p class="small text-secondary mb-0 mt-2"><%= m.ingredients %></p>
                                    <% if (m.calories) { %>
                                    <div class="text-end mt-2">
                                        <span class="badge bg-secondary-subtle text-secondary small"><%= m.calories %> kcal</span>
                                    </div>
                                    <% } %>
                                </div>
                            </div>
                            <% }); %>
                        </div>
                    </div>
                    <% }); %>
                </div>

                <% if (plan.recommendations && plan.recommendations.length > 0) { %>
                <hr class="opacity-10 my-4">
                <h5 class="fw-bold mb-3"><i class="fas fa-lightbulb me-2 text-warning"></i>Coach Guidelines:</h5>
                <ul class="text-secondary small ps-3">
                    <% plan.recommendations.forEach(function(rec) { %>
                    <li class="mb-2"><%= rec %></li>
                    <% }); %>
                </ul>
                <% } %>
            </div>
            <% } %>
        <% } %>
    </div>
</div>
<% } %>

<% contentFor('scripts') %>
<script src="/static/js/meal.js"></script>
<% %>
