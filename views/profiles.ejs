<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h1 class="font-heading fw-bold mb-1">Family Profiles</h1>
        <p class="text-secondary">Manage personalized profiles for every family member to customize their nutrition goals.</p>
    </div>
    <div class="col-md-4 text-md-end">
        <button class="btn btn-grad px-4 py-2" data-bs-toggle="modal" data-bs-target="#addMemberModal">
            <i class="fas fa-plus me-2"></i>Add Member
        </button>
    </div>
</div>

<% if (members.length === 0) { %>
<div class="glass-card-static text-center p-5 my-5">
    <i class="fas fa-users fa-4x text-grad-primary mb-3"></i>
    <h3 class="fw-bold mb-2">No Profiles Found</h3>
    <p class="text-secondary max-width-500 mx-auto mb-4">To get started with personalized meal plans, calorie tracking, and nutritional advice, please add your first family member profile.</p>
    <button class="btn btn-grad" data-bs-toggle="modal" data-bs-target="#addMemberModal">
        <i class="fas fa-user-plus me-2"></i>Add First Profile
    </button>
</div>
<% } else { %>
<div class="row g-4">
    <% members.forEach(function(member) { %>
    <div class="col-md-6 col-lg-4">
        <div class="glass-card h-100 p-4 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="avatar-circle">
                            <%= member.name[0].toUpperCase() %>
                        </div>
                        <div>
                            <h4 class="mb-0 fw-bold"><%= member.name %></h4>
                            <span class="badge bg-secondary-subtle text-secondary small">
                                <%= member.gender.charAt(0).toUpperCase() + member.gender.slice(1) %>, <%= member.age %> yrs
                            </span>
                        </div>
                    </div>
                    <div>
                        <span class="badge bg-<%= member.bmi_category.color %> badge-pill-grad"><%= member.bmi_category.label %></span>
                    </div>
                </div>

                <hr class="opacity-10 my-3">

                <div class="row g-2 mb-3 text-secondary small">
                    <div class="col-6">
                        <i class="fas fa-arrows-alt-v me-2"></i>Height: <strong><%= member.height_cm %> cm</strong>
                    </div>
                    <div class="col-6">
                        <i class="fas fa-weight me-2"></i>Weight: <strong><%= member.weight_kg %> kg</strong>
                    </div>
                    <div class="col-6">
                        <i class="fas fa-calculator me-2"></i>BMI: <strong><%= member.bmi %></strong>
                    </div>
                    <div class="col-6">
                        <i class="fas fa-burn me-2"></i>Target: <strong><%= member.target_calories %> kcal</strong>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="d-flex gap-2 flex-wrap">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="fas fa-utensils me-1"></i><%= member.dietary_type %></span>
                        <% if (member.regional_preference && member.regional_preference !== 'None') { %>
                        <span class="badge bg-info-subtle text-info border border-info-subtle"><i class="fas fa-map-marker-alt me-1"></i><%= member.regional_preference %></span>
                        <% } %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="fas fa-bullseye me-1"></i><%= member.health_goals %></span>
                    </div>
                </div>

                <% if (member.allergies) { %>
                <div class="alert alert-danger-subtle bg-danger-subtle border border-danger-subtle text-danger py-1 px-2 rounded-2 small mb-3">
                    <i class="fas fa-exclamation-circle me-1"></i>Allergies: <%= member.allergies %>
                </div>
                <% } %>
            </div>

            <div class="d-flex gap-2 mt-4 pt-2 border-top border-secondary-subtle">
                <a href="/dashboard?member_id=<%= member.id %>" class="btn btn-outline-glass btn-sm flex-grow-1">
                    <i class="fas fa-tachometer-alt me-1"></i>Dashboard
                </a>
                <button class="btn btn-outline-glass btn-sm text-primary border-primary-subtle" onclick="openEditModal(<%= member.id %>)">
                    <i class="fas fa-edit"></i>
                </button>
                <button class="btn btn-outline-glass btn-sm text-danger border-danger-subtle" onclick="deleteMember(<%= member.id %>, '<%= member.name %>')">
                    <i class="fas fa-trash"></i>
                </button>
            </div>
        </div>
    </div>
    <% }); %>
</div>
<% } %>

<!-- Add Member Modal -->
<div class="modal fade" id="addMemberModal" tabindex="-1" aria-labelledby="addMemberModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card-static border-0 p-3">
            <div class="modal-header border-0">
                <h4 class="modal-title fw-bold" id="addMemberModalLabel">Add Family Member Profile</h4>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body border-0">
                <form id="addMemberForm">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="addName" class="form-label">Full Name</label>
                            <input type="text" class="form-control" id="addName" required placeholder="e.g. Ramesh Kumar">
                        </div>
                        <div class="col-md-3">
                            <label for="addAge" class="form-label">Age (years)</label>
                            <input type="number" class="form-control" id="addAge" required min="1" max="120" placeholder="e.g. 35">
                        </div>
                        <div class="col-md-3">
                            <label for="addGender" class="form-label">Gender</label>
                            <select class="form-select" id="addGender" required>
                                <option value="" disabled selected>Select</option>
                                <option value="male">Male</option>
                                <option value="female">Female</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                        
                        <div class="col-md-6">
                            <label for="addHeight" class="form-label">Height (cm)</label>
                            <input type="number" class="form-control" id="addHeight" required min="50" max="250" step="0.1" placeholder="e.g. 172">
                        </div>
                        <div class="col-md-6">
                            <label for="addWeight" class="form-label">Weight (kg)</label>
                            <input type="number" class="form-control" id="addWeight" required min="10" max="300" step="0.1" placeholder="e.g. 72.5">
                        </div>

                        <div class="col-md-6">
                            <label for="addActivity" class="form-label">Activity Level</label>
                            <select class="form-select" id="addActivity" required>
                                <option value="" disabled selected>Select activity level</option>
                                <option value="sedentary">Sedentary (Little/no exercise)</option>
                                <option value="light">Lightly Active (Light exercise 1-3 days/wk)</option>
                                <option value="moderate">Moderately Active (Moderate exercise 3-5 days/wk)</option>
                                <option value="active">Very Active (Hard exercise 6-7 days/wk)</option>
                                <option value="extra">Extra Active (Very physical job or athletic training)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="addDiet" class="form-label">Dietary Preference</label>
                            <select class="form-select" id="addDiet" required>
                                <option value="" disabled selected>Select diet type</option>
                                <option value="Vegetarian">Vegetarian (Lacto-vegetarian)</option>
                                <option value="Vegan">Vegan (Plant-based)</option>
                                <option value="Eggetarian">Eggetarian (Egg-eating Vegetarian)</option>
                                <option value="Non-Vegetarian">Non-Vegetarian</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label for="addGoal" class="form-label">Health Goal</label>
                            <select class="form-select" id="addGoal" required>
                                <option value="" disabled selected>Select health goal</option>
                                <option value="Weight Loss">Weight Loss (Caloric Deficit)</option>
                                <option value="Muscle Gain">Muscle Gain (Caloric Surplus)</option>
                                <option value="Maintenance">Maintenance (Balanced Calories)</option>
                                <option value="Managing Health">Managing Diabetes / Health Conditions</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="addRegional" class="form-label">Indian Regional Staple Preference</label>
                            <select class="form-select" id="addRegional">
                                <option value="None">No regional preference (Standard Indian)</option>
                                <option value="North Indian">North Indian (Rotis, Dals, Sabzis)</option>
                                <option value="South Indian">South Indian (Idli/Dosa, Sambar, Rice)</option>
                                <option value="West Indian">West Indian (Thepla, Khichdi, Kadhi)</option>
                                <option value="East Indian">East Indian (Rice, Fish, Dalma)</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label for="addAllergies" class="form-label">Allergies / Intolerances (Optional)</label>
                            <input type="text" class="form-control" id="addAllergies" placeholder="e.g. Gluten, Peanuts, Lactose (comma separated)">
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="button" class="btn btn-outline-glass" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-grad">Create Profile</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Member Modal -->
<div class="modal fade" id="editMemberModal" tabindex="-1" aria-labelledby="editMemberModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card-static border-0 p-3">
            <div class="modal-header border-0">
                <h4 class="modal-title fw-bold" id="editMemberModalLabel">Edit Family Member Profile</h4>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body border-0">
                <form id="editMemberForm">
                    <input type="hidden" id="editMemberId">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="editName" class="form-label">Full Name</label>
                            <input type="text" class="form-control" id="editName" required placeholder="e.g. Ramesh Kumar">
                        </div>
                        <div class="col-md-3">
                            <label for="editAge" class="form-label">Age (years)</label>
                            <input type="number" class="form-control" id="editAge" required min="1" max="120" placeholder="e.g. 35">
                        </div>
                        <div class="col-md-3">
                            <label for="editGender" class="form-label">Gender</label>
                            <select class="form-select" id="editGender" required>
                                <option value="" disabled>Select</option>
                                <option value="male">Male</option>
                                <option value="female">Female</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                        
                        <div class="col-md-6">
                            <label for="editHeight" class="form-label">Height (cm)</label>
                            <input type="number" class="form-control" id="editHeight" required min="50" max="250" step="0.1" placeholder="e.g. 172">
                        </div>
                        <div class="col-md-6">
                            <label for="editWeight" class="form-label">Weight (kg) <span class="small text-secondary">(Triggers weight log update)</span></label>
                            <input type="number" class="form-control" id="editWeight" required min="10" max="300" step="0.1" placeholder="e.g. 72.5">
                        </div>

                        <div class="col-md-6">
                            <label for="editActivity" class="form-label">Activity Level</label>
                            <select class="form-select" id="editActivity" required>
                                <option value="" disabled>Select activity level</option>
                                <option value="sedentary">Sedentary (Little/no exercise)</option>
                                <option value="light">Lightly Active (Light exercise 1-3 days/wk)</option>
                                <option value="moderate">Moderately Active (Moderate exercise 3-5 days/wk)</option>
                                <option value="active">Very Active (Hard exercise 6-7 days/wk)</option>
                                <option value="extra">Extra Active (Very physical job or athletic training)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="editDiet" class="form-label">Dietary Preference</label>
                            <select class="form-select" id="editDiet" required>
                                <option value="" disabled>Select diet type</option>
                                <option value="Vegetarian">Vegetarian (Lacto-vegetarian)</option>
                                <option value="Vegan">Vegan (Plant-based)</option>
                                <option value="Eggetarian">Eggetarian (Egg-eating Vegetarian)</option>
                                <option value="Non-Vegetarian">Non-Vegetarian</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label for="editGoal" class="form-label">Health Goal</label>
                            <select class="form-select" id="editGoal" required>
                                <option value="" disabled>Select health goal</option>
                                <option value="Weight Loss">Weight Loss (Caloric Deficit)</option>
                                <option value="Muscle Gain">Muscle Gain (Caloric Surplus)</option>
                                <option value="Maintenance">Maintenance (Balanced Calories)</option>
                                <option value="Managing Health">Managing Diabetes / Health Conditions</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="editRegional" class="form-label">Indian Regional Staple Preference</label>
                            <select class="form-select" id="editRegional">
                                <option value="None">No regional preference (Standard Indian)</option>
                                <option value="North Indian">North Indian (Rotis, Dals, Sabzis)</option>
                                <option value="South Indian">South Indian (Idli/Dosa, Sambar, Rice)</option>
                                <option value="West Indian">West Indian (Thepla, Khichdi, Kadhi)</option>
                                <option value="East Indian">East Indian (Rice, Fish, Dalma)</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label for="editAllergies" class="form-label">Allergies / Intolerances (Optional)</label>
                            <input type="text" class="form-control" id="editAllergies" placeholder="e.g. Gluten, Peanuts, Lactose (comma separated)">
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="button" class="btn btn-outline-glass" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-grad">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<% contentFor('scripts') %>
<script>
    // Handle Add Member Submission
    document.getElementById('addMemberForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const payload = {
            name: document.getElementById('addName').value,
            age: parseInt(document.getElementById('addAge').value),
            gender: document.getElementById('addGender').value,
            height_cm: parseFloat(document.getElementById('addHeight').value),
            weight_kg: parseFloat(document.getElementById('addWeight').value),
            activity_level: document.getElementById('addActivity').value,
            dietary_type: document.getElementById('addDiet').value,
            allergies: document.getElementById('addAllergies').value,
            health_goals: document.getElementById('addGoal').value,
            regional_preference: document.getElementById('addRegional').value
        };

        try {
            const response = await fetch('/api/members', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            });

            const data = await response.json();
            if (response.ok) {
                // Success: Reload page to show new profile
                window.location.reload();
            } else {
                alert(`Error: ${data.error}`);
            }
        } catch (err) {
            console.error("Failed to add profile:", err);
            alert("Error sending request to server.");
        }
    });

    // Handle Delete Profile
    async function deleteMember(id, name) {
        if (!confirm(`Are you sure you want to permanently delete the profile for ${name}? All charts, weight logs, and meal plans for them will be removed.`)) {
            return;
        }

        try {
            const response = await fetch(`/api/members/${id}`, {
                method: 'DELETE'
            });
            const data = await response.json();
            if (response.ok) {
                window.location.reload();
            } else {
                alert(`Error deleting member: ${data.error}`);
            }
        } catch (err) {
            console.error(err);
            alert("Error communicating with server.");
        }
    }

    // Open Edit Profile Modal
    async function openEditModal(id) {
        try {
            const response = await fetch(`/api/members/${id}`);
            if (!response.ok) throw new Error("Failed to fetch profile details.");
            
            const member = await response.json();
            
            // Populate Edit Form fields
            document.getElementById('editMemberId').value = member.id;
            document.getElementById('editName').value = member.name;
            document.getElementById('editAge').value = member.age;
            document.getElementById('editGender').value = member.gender.toLowerCase();
            document.getElementById('editHeight').value = member.height_cm;
            document.getElementById('editWeight').value = member.weight_kg;
            document.getElementById('editActivity').value = member.activity_level.toLowerCase();
            document.getElementById('editDiet').value = member.dietary_type;
            document.getElementById('editGoal').value = member.health_goals;
            document.getElementById('editRegional').value = member.regional_preference;
            document.getElementById('editAllergies').value = member.allergies || '';
            
            // Show Modal
            const editModal = new bootstrap.Modal(document.getElementById('editMemberModal'));
            editModal.show();
        } catch (err) {
            console.error(err);
            alert("Error fetching family member details.");
        }
    }

    // Handle Edit Profile Submission
    document.getElementById('editMemberForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const id = document.getElementById('editMemberId').value;
        const payload = {
            name: document.getElementById('editName').value,
            age: parseInt(document.getElementById('editAge').value),
            gender: document.getElementById('editGender').value,
            height_cm: parseFloat(document.getElementById('editHeight').value),
            weight_kg: parseFloat(document.getElementById('editWeight').value),
            activity_level: document.getElementById('editActivity').value,
            dietary_type: document.getElementById('editDiet').value,
            allergies: document.getElementById('editAllergies').value,
            health_goals: document.getElementById('editGoal').value,
            regional_preference: document.getElementById('editRegional').value
        };

        try {
            const response = await fetch(`/api/members/${id}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            });

            const data = await response.json();
            if (response.ok) {
                window.location.reload();
            } else {
                alert(`Error: ${data.error}`);
            }
        } catch (err) {
            console.error("Failed to edit profile:", err);
            alert("Error sending request to server.");
        }
    });
</script>
<% %>
