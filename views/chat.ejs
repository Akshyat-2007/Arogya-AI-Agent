<% if (!selected_member) { %>
<div class="glass-card-static text-center p-5 my-5">
    <i class="fas fa-comments fa-4x text-grad-primary mb-3"></i>
    <h3 class="fw-bold mb-2">Setup Your Profiles First</h3>
    <p class="text-secondary max-width-500 mx-auto mb-4">No family profiles exist yet. Please create a member profile to start chatting with your AI nutrition coach.</p>
    <a href="/profiles" class="btn btn-grad px-4 py-2">
        <i class="fas fa-plus me-2"></i>Create Profile
    </a>
</div>
<% } else { %>
<div class="row justify-content-center">
    <div class="col-lg-10">
        <!-- Chat Interface Card -->
        <div class="glass-card-static rounded-4 overflow-hidden shadow-lg border border-secondary-subtle">
            <!-- Header of Chat -->
            <div class="p-3 bg-secondary-subtle border-bottom border-secondary-subtle d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <div class="avatar-circle" style="width: 36px; height: 36px; font-size: 1rem;">
                        <i class="fas fa-robot"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 fw-bold">Arogya AI Coach</h5>
                        <p class="small text-secondary mb-0">Personalized chat assistant for family health</p>
                    </div>
                </div>

                <!-- Chat Member Switcher -->
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-secondary fw-semibold d-none d-sm-inline">Chatting For:</span>
                    <select class="form-select form-select-sm border-secondary-subtle" id="chatMemberSelect" style="width: auto; min-width: 150px;">
                        <% members.forEach(function(m) { %>
                        <option value="<%= m.id %>" <%= m.id === selected_member.id ? 'selected' : '' %>><%= m.name %></option>
                        <% }); %>
                    </select>
                </div>
            </div>

            <!-- Messages Logs Container -->
            <div class="chat-window" id="chatWindow">
                <!-- Messages appended dynamically by javascript -->
            </div>

            <!-- Input Bar Form -->
            <div class="chat-input-container">
                <form id="chatForm" class="d-flex gap-2">
                    <input type="text" class="form-control border-secondary-subtle py-2 px-3" id="chatInput" autocomplete="off" required placeholder="Ask about healthy replacements, recipes, calories, macro advice...">
                    <button type="submit" class="btn btn-grad px-4 py-2 d-flex align-items-center gap-2">
                        <span>Send</span><i class="fas fa-paper-plane"></i>
                    </button>
                </form>
                <div class="d-flex flex-wrap gap-2 mt-3 justify-content-center justify-content-lg-start small opacity-75">
                    <span class="text-secondary fw-semibold">Quick Prompts:</span>
                    <button type="button" class="btn btn-link btn-xs text-secondary p-0 border-0 text-decoration-none me-2 hover-primary" onclick="setQuickPrompt('What is a healthy South Indian high protein breakfast?')">"Healthy South Indian high protein breakfast"</button>
                    <button type="button" class="btn btn-link btn-xs text-secondary p-0 border-0 text-decoration-none me-2 hover-primary" onclick="setQuickPrompt('Give me a high protein vegetarian substitute for chicken.')">"Vegetarian substitute for chicken"</button>
                    <button type="button" class="btn btn-link btn-xs text-secondary p-0 border-0 text-decoration-none hover-primary" onclick="setQuickPrompt('Can you suggest a diet plan to manage high blood pressure?')">"Diet plan to manage blood pressure"</button>
                </div>
            </div>
        </div>
    </div>
</div>
<% } %>

<% contentFor('scripts') %>
<script src="/static/js/chat.js"></script>
<script>
    function setQuickPrompt(promptText) {
        const input = document.getElementById('chatInput');
        if (input) {
            input.value = promptText;
            input.focus();
        }
    }
</script>
<% %>
