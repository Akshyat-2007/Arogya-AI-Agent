<div class="row justify-content-center">
    <div class="col-lg-10">
        <h1 class="font-heading fw-bold mb-1">Body Mass Index (BMI) Calculator</h1>
        <p class="text-secondary mb-4">Body mass index (BMI) is a measure of body fat based on height and weight that applies to adult men and women.</p>

        <div class="row g-4">
            <!-- Form Card -->
            <div class="col-md-5">
                <div class="glass-card p-4 h-100">
                    <h5 class="fw-bold mb-3"><i class="fas fa-calculator me-2 text-grad-primary"></i>Calculate BMI</h5>
                    <form id="bmiCalcForm">
                        <div class="mb-3">
                            <label for="bmiHeight" class="form-label">Height (cm)</label>
                            <input type="number" step="0.1" class="form-control" id="bmiHeight" required placeholder="e.g. 175" min="50" max="250">
                        </div>
                        <div class="mb-4">
                            <label for="bmiWeight" class="form-label">Weight (kg)</label>
                            <input type="number" step="0.1" class="form-control" id="bmiWeight" required placeholder="e.g. 70" min="10" max="300">
                        </div>
                        <button type="submit" class="btn btn-grad w-100 py-2.5">
                            <i class="fas fa-magic me-2"></i>Compute BMI
                        </button>
                    </form>
                </div>
            </div>

            <!-- Results Card -->
            <div class="col-md-7">
                <div class="glass-card-static p-4 h-100 d-flex flex-column justify-content-between" id="bmiResultPlaceholder">
                    <div class="text-center my-auto py-5 opacity-75">
                        <i class="fas fa-chart-bar fa-3x mb-3 text-secondary"></i>
                        <p>Enter your height and weight to calculate your BMI and nutritional guidelines.</p>
                    </div>
                </div>

                <!-- Hidden results container that will be displayed by JS -->
                <div class="glass-card-static p-4 h-100 d-none flex-column justify-content-between" id="bmiResultContainer">
                    <div>
                        <h5 class="fw-bold mb-1">Calculation Results</h5>
                        <hr class="opacity-10 my-3">

                        <div class="row align-items-center">
                            <div class="col-6">
                                <span class="text-secondary small">YOUR SCORE</span>
                                <h1 class="fw-bold font-heading display-4 mb-0 text-grad-primary" id="resultBmiScore">22.5</h1>
                            </div>
                            <div class="col-6 text-end">
                                <span class="text-secondary small d-block">CATEGORY</span>
                                <span class="badge badge-pill-grad fs-5" id="resultBmiCategory">Normal Weight</span>
                            </div>
                        </div>

                        <!-- Visual Dial slider -->
                        <div class="bmi-wheel-container">
                            <div class="bmi-pin" id="resultBmiPin" style="left: 50%;"></div>
                        </div>
                        <div class="d-flex justify-content-between text-secondary small px-1 mb-4">
                            <span>15 (Under)</span>
                            <span>18.5 (Normal)</span>
                            <span>25 (Over)</span>
                            <span>30+ (Obese)</span>
                        </div>

                        <div class="alert bg-secondary-subtle border border-secondary-subtle p-3 rounded-3 small text-secondary mb-0">
                            <h6 class="fw-bold text-primary mb-1"><i class="fas fa-heartbeat me-1"></i>Health Assessment:</h6>
                            <span id="resultBmiDesc">You are in a healthy weight range. Maintain a balanced diet and regular physical activity.</span>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top border-secondary-subtle text-end">
                        <button class="btn btn-grad btn-sm" id="btnCreateFromBmi">
                            <i class="fas fa-user-plus me-1"></i>Create Profile with this BMI
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- BMI Guidelines Table Reference -->
        <div class="glass-card-static p-4 mt-4">
            <h5 class="fw-bold mb-3"><i class="fas fa-info-circle me-2 text-grad-primary"></i>Standard BMI Reference Chart</h5>
            <div class="table-responsive">
                <table class="table table-sm border-secondary-subtle text-secondary align-middle mb-0">
                    <thead>
                        <tr class="text-white border-bottom border-secondary-subtle">
                            <th>BMI Range</th>
                            <th>Classification</th>
                            <th>Health Risks</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Below 18.5</td>
                            <td><span class="badge bg-warning-subtle text-warning border border-warning-subtle">Underweight</span></td>
                            <td>Malnutrition, osteoporosis, anemia, and immune deficiencies.</td>
                        </tr>
                        <tr>
                            <td>18.5 &ndash; 24.9</td>
                            <td><span class="badge bg-success-subtle text-success border border-success-subtle">Normal Weight</span></td>
                            <td>Lowest risk of cardiovascular disease, diabetes, and other weight-related conditions.</td>
                        </tr>
                        <tr>
                            <td>25.0 &ndash; 29.9</td>
                            <td><span class="badge bg-warning-subtle text-warning border border-warning-subtle">Overweight</span></td>
                            <td>Increased risk of high blood pressure, coronary heart disease, and type 2 diabetes.</td>
                        </tr>
                        <tr>
                            <td>30.0 and above</td>
                            <td><span class="badge bg-danger-subtle text-danger border border-danger-subtle">Obese</span></td>
                            <td>High risk of heart disease, stroke, sleep apnea, osteoarthritis, and metabolic syndromes.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<% contentFor('scripts') %>
<script>
    document.getElementById('bmiCalcForm').addEventListener('submit', (e) => {
        e.preventDefault();
        
        const h = parseFloat(document.getElementById('bmiHeight').value);
        const w = parseFloat(document.getElementById('bmiWeight').value);

        if (!h || !w || isNaN(h) || isNaN(w)) return;

        // Calculate BMI
        const heightM = h / 100.0;
        const bmi = w / (heightM * heightM);
        const roundedBmi = Math.round(bmi * 10) / 10;

        // Determine category
        let category = '';
        let colorClass = '';
        let assessment = '';
        
        // Map BMI score to slider left percent: Range 15 to 35
        let percent = ((bmi - 15) / (35 - 15)) * 100;
        percent = Math.max(0, Math.min(percent, 100)); // Clamp between 0 and 100

        if (bmi < 18.5) {
            category = 'Underweight';
            colorClass = 'warning';
            assessment = 'Your BMI is below the healthy range. Focus on nutrient-rich foods, healthy fats, and strength training. We recommend consulting a healthcare expert to build a healthy calorie surplus plan.';
        } else if (bmi >= 18.5 && bmi < 25) {
            category = 'Normal Weight';
            colorClass = 'success';
            assessment = 'Congratulations! You are in a healthy, normal weight range. Focus on maintaining your balanced lifestyle, high fiber foods, clean proteins, and regular exercise.';
        } else if (bmi >= 25 && bmi < 30) {
            category = 'Overweight';
            colorClass = 'warning';
            assessment = 'Your weight is slightly high. Re-examine your portion sizes, reduce refined sugars/processed carbs, and increase active exercise (at least 150 mins per week).';
        } else {
            category = 'Obese';
            colorClass = 'danger';
            assessment = 'Your BMI falls into the obesity category. High risk for insulin resistance, hypertension, and heart issues. We strongly suggest starting a structural diet plan (low fat, calorie deficit) and working with a doctor or dietitian.';
        }

        // Hide placeholder and show results container
        document.getElementById('bmiResultPlaceholder').classList.add('d-none');
        const container = document.getElementById('bmiResultContainer');
        container.classList.remove('d-none');
        container.classList.add('d-flex');

        // Populate values
        document.getElementById('resultBmiScore').innerText = roundedBmi;
        
        const catBadge = document.getElementById('resultBmiCategory');
        catBadge.innerText = category;
        catBadge.className = `badge bg-${colorClass}-subtle text-${colorClass} border border-${colorClass}-subtle fs-6 py-2 px-3`;
        
        document.getElementById('resultBmiDesc').innerText = assessment;
        document.getElementById('resultBmiPin').style.left = `${percent}%`;

        // Configure Create Profile redirection button
        const createBtn = document.getElementById('btnCreateFromBmi');
        createBtn.onclick = () => {
            // Redirect to profiles with URL parameters
            const url = new URL(window.location.origin + '/profiles');
            // Check modal trigger and prefill
            // To make it easy, we store in session/local storage then redirect
            const prefill = {
                height: h,
                weight: w
            };
            localStorage.setItem('bmi_prefill', JSON.stringify(prefill));
            window.location.href = url.toString() + '?prefill=true';
        };
    });

    // Auto load prefill trigger on profiles page if redirected
    document.addEventListener('DOMContentLoaded', () => {
        // If on the profiles page and URL has prefill parameter, load from local storage
        if (window.location.pathname.endsWith('/profiles') && window.location.search.includes('prefill=true')) {
            const prefillStr = localStorage.getItem('bmi_prefill');
            if (prefillStr) {
                const prefill = JSON.parse(prefillStr);
                
                // Open modal first
                const modal = new bootstrap.Modal(document.getElementById('addMemberModal'));
                modal.show();
                
                // Populate fields
                document.getElementById('addHeight').value = prefill.height;
                document.getElementById('addWeight').value = prefill.weight;
                
                // Clear local storage
                localStorage.removeItem('bmi_prefill');
            }
        }
    });
</script>
<% %>
